{
  "expo": {
    "name": "nibble",
    "slug": "nibble-app",
    "owner": "taigamura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nibble.mvp",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.nibble.mvp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nibble uses your location to show nearby places worth swiping on."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b6fd4e34-dab9-412f-a55a-43c7e740bfc9"
      }
    }
  }
}
