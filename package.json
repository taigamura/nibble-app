{
  "name": "nibble-app",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingestPlaces.ts",
    "enrich": "tsx --env-file-if-exists=.env scripts/enrichPlaces.ts",
    "seed:data": "npm run ingest && npm run enrich"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.13",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "^57.0.11",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-location": "~57.0.10",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.scaffold-tmp/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
