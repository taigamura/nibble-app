# Real backend config (issue #3). All three must be set for the app to use
# SupabasePlacesProvider; if any are missing, App.tsx falls back to the
# in-memory fixtures so the app stays runnable without secrets.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# scripts/ingestPlaces.ts only (never bundled into the app):
GOOGLE_PLACES_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
